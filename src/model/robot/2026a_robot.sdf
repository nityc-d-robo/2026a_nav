<?xml version="1.0"?>
<sdf version="1.9">
  <model name="2026a_robot" canonical_link="base_link">
    <pose>0 0 0.1 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>35</mass> <!-- weight --> 
        <inertia>
          <ixx>0.6083333333</ixx>
          <iyy>0.6083333333</iyy>
          <izz>1.0666666667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- STLのCAD原点を維持した表示形状 -->
      <visual name="body_visual">
        <pose>0 0 0 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <mesh>
              <uri>meshes/2026a_robot.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.35 0.7 1</ambient>
          <diffuse>0.1 0.35 0.7 1</diffuse>
        </material>
      </visual>

      <collision name="body_collision">
        <!-- visualの外接箱：X,Y=0..0.86、Z=0..0.157 m -->
        <pose>0.43 0.43 0.0785 0 0 0</pose>
        <geometry>
          <box><size>0.86 0.86 0.157</size></box>
        </geometry>
      </collision>

      <!-- 計測中心を示すマゼンタの球。センサposeのxyzと合わせる。 -->
      <visual name="lidar_origin_marker">
        <pose>0.43 0.43 0.019 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <!-- bit 0をマーカーに使い、LiDARのvisibility_maskから除外する。 -->
        <visibility_flags>1</visibility_flags>
        <geometry>
          <sphere><radius>0.008</radius></sphere>
        </geometry>
        <material>
          <ambient>1 0 1 1</ambient>
          <diffuse>1 0 1 1</diffuse>
          <emissive>1 0 1 1</emissive>
        </material>
      </visual>

      <sensor name="rplidar_a2m8" type="gpu_lidar">
        <!-- 本体中央の計測中心。X前方を保ったまま上下反転 -->
        <pose>0.43 0.43 0.019 3.14159265359 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>laser_frame</gz_frame_id>
        <lidar>
          <!-- 位置表示マーカーだけを測距対象から除外。本体STLは測距対象。 -->
          <visibility_mask>4294967294</visibility_mask>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <!-- 400点を0.9度間隔にし、始点と終点の重複を避ける -->
              <max_angle>3.12588469032</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- 本体除去の暫定下限：中心から外接箱の角まで約0.608 m + 余裕 -->
            <min>0.62</min>
            <max>12.0</max>
            <resolution>0.0005</resolution>
          </range>
          <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
          </noise>
        </lidar>
        <visualize>true</visualize>
        <always_on>true</always_on>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/odom_tf</tf_topic>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
  </model>
</sdf>
